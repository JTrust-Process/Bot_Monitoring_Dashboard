# dashboard/.env.local.example
# Copy to .env.local and fill in real values. .env.local is gitignored.

# ── Existing per-bot Supabase projects ────────────────────────────────────────
NEXT_PUBLIC_CRYPTO_SUPABASE_URL=https://YOUR_CRYPTO_PROJECT.supabase.co
NEXT_PUBLIC_CRYPTO_SUPABASE_ANON_KEY=YOUR_CRYPTO_ANON_KEY

NEXT_PUBLIC_STOCK_SUPABASE_URL=https://YOUR_STOCK_PROJECT.supabase.co
NEXT_PUBLIC_STOCK_SUPABASE_ANON_KEY=YOUR_STOCK_ANON_KEY

# Repo + dashboard links shown on the Health page
NEXT_PUBLIC_CRYPTO_REPO_URL=https://github.com/YOUR_ORG/Crypto_Trading_Bot
NEXT_PUBLIC_CRYPTO_DASHBOARD_URL=https://your-crypto-dashboard.vercel.app/
NEXT_PUBLIC_STOCK_REPO_URL=https://github.com/YOUR_ORG/Trading-Bot-Project
NEXT_PUBLIC_STOCK_DASHBOARD_URL=https://your-stock-dashboard.vercel.app/

# Optional repo-link displayed in the header
NEXT_PUBLIC_REPO_URL=https://github.com/YOUR_ORG/Bot_Monitoring_Dashboard

# Health monitor (Python script in monitor/) — Discord webhook
HEALTH_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK
# Optional GitHub PAT used ONLY when restart_enabled=True in BotConfig.
# Disabled by default — leave blank if you haven't opted in.
GH_PAT_BOT_RESTART=

# ── Trading Bot League (NEW — Stage 4) ────────────────────────────────────────
# Anon (NOT service-role) key from the new Trading Bot League Supabase project.
# RLS policies in 001..008 only allow SELECT for anon — safe to expose
# client-side, same pattern as the two existing per-bot projects above.
NEXT_PUBLIC_LEAGUE_SUPABASE_URL=https://YOUR_LEAGUE_PROJECT.supabase.co
NEXT_PUBLIC_LEAGUE_SUPABASE_ANON_KEY=YOUR_LEAGUE_ANON_KEY

# ── Approvals endpoint (NEW — Stage 5e) ───────────────────────────────────────
# Server-side ONLY. These are read by app/api/approvals/[id]/route.js and
# MUST NOT have a NEXT_PUBLIC_ prefix — they would leak the service-role key
# into the browser bundle, which is a security incident.
#
# LEAGUE_SUPABASE_URL is the same URL as above but without the NEXT_PUBLIC_ —
# Next.js will only expose vars with that prefix to client code, so we need
# a separate non-prefixed copy for the server route.
LEAGUE_SUPABASE_URL=https://YOUR_LEAGUE_PROJECT.supabase.co
LEAGUE_SUPABASE_SERVICE_KEY=YOUR_LEAGUE_SERVICE_ROLE_KEY

# Shared operator token. The dashboard prompts for this once per session,
# stores it in sessionStorage, and sends it as `Authorization: Bearer <token>`.
# Generate any opaque random string — `openssl rand -hex 32` works.
LEAGUE_APPROVAL_TOKEN=YOUR_OPAQUE_RANDOM_TOKEN
